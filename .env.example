# Server-only settings for the AKBS CRM gateway (same Supabase project as akbspoultryweb).
# Never expose these with a NEXT_PUBLIC_ prefix and never use a service-role key.
AKBS_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AKBS_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
AKBS_CRM_GATEWAY_KEY=YOUR_CRM_GATEWAY_KEY
# Comma-separated origins allowed to POST to /api/crm (crm.akbspoultry.com is always allowed).
AKBS_ALLOWED_ORIGINS=https://crm.akbspoultry.com
