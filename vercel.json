{
  "git": {
    "deploymentEnabled": {
      "fix/canonical-customer-payments": false
    }
  },
  "rewrites": [
    {
      "source": "/soft-quotations",
      "destination": "/index.html"
    },
    {
      "source": "/soft-quotations/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/customer-registration",
      "destination": "/index.html"
    },
    {
      "source": "/customer-registration/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/partner-registration",
      "destination": "/index.html"
    },
    {
      "source": "/partner-registration/:path*",
      "destination": "/index.html"
    }
  ]
}
