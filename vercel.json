{
  "git": {
    "deploymentEnabled": {
      "fix/canonical-customer-payments": false
    }
  },
  "rewrites": [
    {
      "source": "/soft-quotations",
      "destination": "/index.html"
    },
    {
      "source": "/soft-quotations/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/customer-registration",
      "destination": "/index.html"
    },
    {
      "source": "/customer-registration/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/partner-registration",
      "destination": "/index.html"
    },
    {
      "source": "/partner-registration/:path*",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://ldffgetuzoeupuhoaubn.supabase.co; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
